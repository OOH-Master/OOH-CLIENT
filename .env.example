# =====================================================================
# OOH Flutter Client — Environment variables
#
# Flutter ne čita .env fajl automatski. Vrednosti se injektuju kao
# --dart-define flag-ovi pri build-u (vidi GitHub Actions workflows).
#
# Ovaj fajl postoji kao REFERENCA — DevOps treba ove vrednosti da
# konfiguriše u GitHub repo:
#   Settings → Secrets and variables → Actions → Variables
# =====================================================================

# --- API endpoint backend-a (production URL na Render-u) ---
API_BASE_URL=https://ooh-backend.onrender.com/api/v1

# --- Lokalno (za development) ---
# API_BASE_URL=http://localhost:8080/api/v1

# --- Verzija aplikacije (auto-injektuje se iz git SHA pri CI build-u) ---
APP_VERSION=local-dev
